!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
dist/
build/

# Production / local cache
.cache/
.turbo/
.vercel/
.netlify/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Database / Prisma local files
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# Uploaded/local private files
uploads/
private/
secrets/
credentials/
keys/
*.pem
*.key
*.crt
*.p12
*.pfx

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Test and coverage output
coverage/
test-results/
playwright-report/

# Temporary and private files
tmp/
temp/
scratch/
private/
secrets/
credentials/
personal/
notes/
*.tmp

# AI/generated local context archives
*.zip
*.tar
*.tar.gz

# Package manager cache
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# TypeScript
*.tsbuildinfo
next-env.d.ts

